{
  "name": "resonance",
  "productName": "Resonance",
  "version": "0.5.6",
  "description": "Offline music player in Material 3 Expressive style, with YouTube search, synced lyrics and a 10-band equalizer",
  "main": "src/boot.js",
  "author": "RedArtem39",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "start": "electron .",
    "icons": "electron tools/make-icons.js",
    "installer": "node installer/build.js",
    "dist:nsis": "electron-builder --win nsis"
  },
  "dependencies": {
    "music-metadata": "^12.3.0",
    "yt-search": "^2.13.1"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.redartem39.resonance",
    "productName": "Resonance",
    "copyright": "Copyright © 2026 RedArtem39. Licensed under GPL-3.0-or-later.",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Resonance",
      "license": "build/license.txt",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "electronLanguages": [
      "en-US",
      "ru"
    ]
  }
}
